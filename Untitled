const fs = require('fs')
const c = fs.readFileSync('src/Dashboard.jsx', 'utf8')
const lines = c.split('\n')
let d = 0
for (let i = 0; i < lines.length; i++) {
  const l = lines[i]
  for (const ch of l) {
    if (ch === '(') d++
    else if (ch === ')') {
      d--
      if (d < 0) {
        console.log('ERRO linha ' + (i + 1) + ': ' + l.trim().substring(0, 80))
        d = 0
      }
    }
  }
}
console.log('fim d=' + d)